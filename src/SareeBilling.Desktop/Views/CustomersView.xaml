<UserControl x:Class="SareeBilling.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             xmlns:views="clr-namespace:SareeBilling.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewModel}">
    <Grid Margin="0,0,16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- ===== Customer list ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ New customer"
                        Command="{Binding NewCommand}" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Content="Show inactive" Margin="12,0,0,0"
                          IsChecked="{Binding ShowInactive}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by name, GSTIN, city or phone"
                         AutomationProperties.Name="Search customers" />
            </DockPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                      AutomationProperties.Name="Customer list">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="2*" MinWidth="140"
                                        ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" MinWidth="80"
                                        ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="1.3*" MinWidth="100"
                                        ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="1.4*" MinWidth="120"
                                        ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceText}" Width="140"
                                        ElementStyle="{StaticResource AmountCellText}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding ResultSummary}" />
        </Grid>

        <!-- ===== Add / edit form ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleText}" Text="{Binding Editor.Heading}"
                           Margin="20,18,20,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <views:CustomerFormFields Margin="20,0,4,4" DataContext="{Binding Editor}" />

                        <!-- ===== Old bills from before this app (bill-wise opening balance) ===== -->
                        <StackPanel Margin="20,4,16,12" Visibility="{Binding Editor.IsExisting, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Receive payment"
                                        Command="{Binding ReceivePaymentCommand}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Ledger"
                                        Command="{Binding OpenLedgerCommand}" />
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Old bills (opening balance)" FontSize="15" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Enter each bill still unpaid from before using this app (for example from Tally), or an advance the customer had paid." />

                            <ItemsControl ItemsSource="{Binding OpeningBills}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OpeningBillRowView}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Remove"
                                                    Command="{Binding DataContext.RemoveOpeningBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontWeight="SemiBold" Margin="8,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource HintText}" Margin="0">
                                                    <Run Text="{Binding DateText, Mode=OneWay}" /> <Run Text="{Binding UsedText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding OpeningTotalText}" FontWeight="SemiBold" Margin="0,2,0,10" />

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding OpeningSides}" SelectedItem="{Binding NewOpeningSide}"
                                              DisplayMemberPath="Label" Margin="0,0,0,8" AutomationProperties.Name="Old entry type" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewOpeningNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Bill no. (e.g. Tally 145)" MaxLength="40" AutomationProperties.Name="Old bill number" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding NewOpeningDate}" AutomationProperties.Name="Old bill date" />
                                    </Grid>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add"
                                                Command="{Binding AddOpeningBillCommand}" Margin="8,0,0,0" MinWidth="70" />
                                        <TextBox Text="{Binding NewOpeningAmount, UpdateSourceTrigger=PropertyChanged}" Tag="Amount pending (₹)"
                                                 TextAlignment="Right" AutomationProperties.Name="Old bill amount" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding OpeningError}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" Visibility="{Binding OpeningError, Converter={StaticResource VisibleWhenNotEmpty}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="20,8,20,18">
                    <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <Border Style="{StaticResource SuccessBox}" Margin="0,0,0,10"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                        <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
                    </Border>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Delete"
                                Command="{Binding DeleteCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Clear" Command="{Binding NewCommand}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
