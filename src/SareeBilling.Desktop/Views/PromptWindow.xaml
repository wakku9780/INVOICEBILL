<Window x:Class="SareeBilling.Desktop.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FocusManager.FocusedElement="{Binding ElementName=AnswerBox}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="AnswerBox" Style="{StaticResource MultiLineTextBox}" MaxLength="1000" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="OnOk" />
            <Button Style="{StaticResource SecondaryButton}" Content="Go back" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
