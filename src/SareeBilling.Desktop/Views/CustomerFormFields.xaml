<UserControl x:Class="SareeBilling.Desktop.Views.CustomerFormFields"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomerEditorViewModel}">
    <!-- Customer form fields, shared by the Customers page and the "New customer" dialog.
         DataContext must be a CustomerEditorViewModel. -->
    <StackPanel>
        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Customer name *" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Customer Firm Name" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
            <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Tag="Optional"
                     CharacterCasing="Upper" MaxLength="15" FontFamily="Consolas" FontSize="15" />
            <TextBlock Style="{StaticResource GstinHintText}" Text="{Binding GstinHint.Message}"
                       Visibility="{Binding GstinHint.Message, Converter={StaticResource VisibleWhenNotEmpty}}" />
            <TextBlock Style="{StaticResource HintText}" Text="Leave empty if the customer is not GST registered." />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="State *" />
            <ComboBox ItemsSource="{Binding States}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code" SelectedValue="{Binding StateCode}" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Decides the tax: same state as yours = CGST + SGST, other state = IGST." />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Address line 1 *" />
            <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Address line 2" />
            <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="City *" />
                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Pincode" />
                <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
            </StackPanel>
        </Grid>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Phone" />
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Credit days" />
            <TextBox Text="{Binding CreditDaysText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                     MaxLength="3" AutomationProperties.Name="Credit days" />
            <TextBlock Style="{StaticResource HintText}"
                       Text="Days allowed to pay. A new invoice becomes overdue after its date plus these days (0 = pay at once)." />
        </StackPanel>

        <CheckBox Content="Active (shown when creating invoices)" IsChecked="{Binding IsActive}"
                  Margin="0,0,0,14"
                  Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
