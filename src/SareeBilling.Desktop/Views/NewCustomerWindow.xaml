<Window x:Class="SareeBilling.Desktop.Views.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
        xmlns:views="clr-namespace:SareeBilling.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewCustomerDialogViewModel}"
        Title="New customer" Width="460" Height="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <views:CustomerFormFields x:Name="Form" Margin="20,18,4,0" DataContext="{Binding Editor}" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="20,8,20,18">
            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="Save customer" Command="{Binding SaveCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelCommand}"
                        IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
