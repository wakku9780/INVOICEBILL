<UserControl x:Class="SareeBilling.Desktop.Views.CreateInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CreateInvoiceViewModel}">
    <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Company not set up ===== -->
        <Border Grid.Row="0" Style="{StaticResource InfoBox}" Margin="0,0,0,16" HorizontalAlignment="Left"
                Visibility="{Binding IsCompanyMissing, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open Company Settings"
                        Margin="16,0,0,0" Command="{Binding OpenCompanySettingsCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Please enter your company details first. They are printed on every invoice." />
            </DockPanel>
        </Border>

        <!-- ===== Saved confirmation ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Left"
                MinWidth="520" Padding="28,24"
                Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="26"
                               Foreground="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SavedHeadline}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding SavedDetails}" Style="{StaticResource MutedText}" Margin="0,10,0,20" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="Print…"
                            Command="{Binding PrintSavedInvoiceCommand}" MinWidth="110" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Preview" Margin="8,0,0,0"
                            Command="{Binding PreviewSavedInvoiceCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Save as PDF…" Margin="8,0,0,0"
                            Command="{Binding SaveSavedInvoicePdfCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Create another invoice"
                            Command="{Binding StartNewInvoiceCommand}" />
                    <Button Style="{StaticResource DangerButton}" Content="Cancel this invoice…" Margin="8,0,0,0"
                            Command="{Binding CancelSavedInvoiceCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Entry form ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}"
                      Visibility="{Binding IsEntryVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!-- Header: customer, date, number -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" MinWidth="260" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Customer (Buyer) *" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                            Content="+ New customer" Margin="8,0,0,0" Command="{Binding NewCustomerCommand}" />
                                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                              DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True"
                                              AutomationProperties.Name="Customer" />
                                </DockPanel>
                                <TextBlock Text="{Binding CustomerDetails}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                <Border Background="{StaticResource SubtleBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding TaxTypeText, Converter={StaticResource VisibleWhenNotEmpty}}">
                                    <TextBlock Text="{Binding TaxTypeText}" FontWeight="SemiBold" FontSize="13" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice date *" />
                                <DatePicker SelectedDate="{Binding InvoiceDate}" DisplayDateEnd="{Binding MaxInvoiceDate, Mode=OneWay}"
                                            SelectedDateFormat="Long" Padding="6" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice number" Margin="0,14,0,4" />
                                <TextBlock Text="{Binding NextNumberText}" FontFamily="Consolas" FontSize="16" FontWeight="Bold" />
                                <TextBlock Style="{StaticResource HintText}" Text="The number is confirmed when you save." />
                            </StackPanel>
                        </Grid>

                        <Expander Header="More details (order no., despatch, destination) — optional" Margin="0,16,0,0">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Buyer's order no." />
                                    <TextBox Text="{Binding BuyerOrderNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Order date" />
                                    <DatePicker SelectedDate="{Binding BuyerOrderDate}" Padding="6" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mode / terms of payment" />
                                    <TextBox Text="{Binding PaymentTerms, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Despatch document no." />
                                    <TextBox Text="{Binding DispatchDocumentNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Despatched through" />
                                    <TextBox Text="{Binding DispatchedThrough, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                             Tag="Transport name" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Destination" />
                                    <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Field}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Terms of delivery" />
                                    <TextBox Text="{Binding TermsOfDelivery, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Items -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Items" Margin="0,0,0,12" />

                        <!-- Entry row: press Enter to add -->
                        <Grid>
                            <Grid.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddLineCommand}" />
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="200" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Description of goods" />
                                <TextBox x:Name="DescriptionBox" Text="{Binding EntryDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="e.g. Pure Lachcha Bdr Booti Tisu Golden Zari" MaxLength="300" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="HSN" />
                                <TextBox Text="{Binding EntryHsnCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" Tag="5007" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Quantity" />
                                <TextBox Text="{Binding EntryQuantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Unit" />
                                <ComboBox ItemsSource="{Binding Units}" Text="{Binding EntryUnit, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Rate (Rs.)" />
                                <TextBox Text="{Binding EntryRate, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="GST %" />
                                <ComboBox ItemsSource="{Binding GstRates}" Text="{Binding EntryGstRate, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding AddLineButtonText}"
                                        Command="{Binding AddLineCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="8,0,0,0"
                                        Command="{Binding CancelLineEditCommand}"
                                        Visibility="{Binding IsEditingLine, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding EntryError}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding EntryError, Converter={StaticResource VisibleWhenNotEmpty}}" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="Press Enter or click Add item. HSN, unit and GST % are kept for the next item." />

                        <DataGrid ItemsSource="{Binding Lines}" Margin="0,12,0,0" MinHeight="120" MaxHeight="340"
                                  AutomationProperties.Name="Invoice items">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="46"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Description of goods" Binding="{Binding Description}" Width="*"
                                                    MinWidth="200" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="64"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="90"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding RateText}" Width="100"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="GST" Binding="{Binding GstRateText}" Width="52"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableText}" Width="115"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Tax" Binding="{Binding TaxText}" Width="100"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="115"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTemplateColumn Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource LinkButton}" Content="Edit"
                                                        Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource LinkButton}" Content="Remove"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Totals and save -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" MinWidth="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount chargeable (in words)" />
                            <TextBlock Text="{Binding AmountInWordsText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource TotalLabel}" Text="Total quantity" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding TotalQuantityText}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource TotalLabel}" Text="Taxable value" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding TaxableTotalText}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource TotalLabel}" Text="CGST"
                                           Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding CgstText}"
                                           Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource TotalLabel}" Text="SGST"
                                           Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding SgstText}"
                                           Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource TotalLabel}" Text="IGST"
                                           Visibility="{Binding ShowIgst, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding IgstText}"
                                           Visibility="{Binding ShowIgst, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Row="5" Style="{StaticResource TotalLabel}" Text="Round off"
                                           Visibility="{Binding RoundOffText, Converter={StaticResource VisibleWhenNotEmpty}}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding RoundOffText}" />

                                <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotalText}" FontSize="22"
                                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="Grand total (Rs.)" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Clear" Command="{Binding ClearCommand}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Save invoice" Margin="8,0,0,0"
                                        Command="{Binding SaveCommand}" MinWidth="150" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
