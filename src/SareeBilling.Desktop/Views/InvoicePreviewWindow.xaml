<Window x:Class="SareeBilling.Desktop.Views.InvoicePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InvoicePreviewViewModel}"
        Title="{Binding WindowTitle}" Width="980" Height="900" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14"
        Background="#E4E7EB" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Close"
                        IsCancel="True" Click="OnClose" Margin="8,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Save as PDF…" Command="{Binding SavePdfCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Print…" Command="{Binding PrintCommand}"
                            Margin="8,0,0,0" MinWidth="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Printout.InvoiceNumber}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding PageCountText}" Style="{StaticResource MutedText}" Margin="12,2,0,0" />
                    <Border Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0"
                            Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CANCELLED" Foreground="{StaticResource ErrorTextBrush}" FontWeight="Bold" FontSize="12" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Pages}" Margin="24" HorizontalAlignment="Center" MaxWidth="900"
                          AutomationProperties.Name="Invoice pages">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="0,0,0,24" BorderBrush="#C7CED6" BorderThickness="1">
                            <Image Source="{Binding}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
