<UserControl x:Class="SareeBilling.Desktop.Views.ReceivePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceivePaymentViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding AutoFillCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,16" MaxWidth="1200" HorizontalAlignment="Left">

            <!-- ===== Customer and receipt details ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Received from (customer) *" />
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" IsTextSearchEnabled="True" IsEditable="False"
                                      AutomationProperties.Name="Customer" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}"
                                    Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Date *" />
                            <DatePicker SelectedDate="{Binding ReceiptDate}" AutomationProperties.Name="Receipt date" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open ledger"
                                Command="{Binding OpenLedgerCommand}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding AccountSummary}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Unused advance: offer to adjust it against bills -->
                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,12"
                            Visibility="{Binding CanAdjustAdvance, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Adjust against bills"
                                    Command="{Binding StartAdjustAdvanceCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding AdvanceNotice}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Grid Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount received (₹) *" />
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                     FontSize="16" FontWeight="SemiBold" AutomationProperties.Name="Amount received" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Paid by *" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Paid by" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding ReferenceLabel}" />
                            <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                     AutomationProperties.Name="Reference" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource Field}" Margin="0"
                                Visibility="{Binding IsReceiving, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Narration" />
                        <TextBox Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" Tag="Optional note" MaxLength="1000" />
                    </StackPanel>

                    <Border Style="{StaticResource InfoBox}"
                            Visibility="{Binding IsAdjustingAdvance, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Back to receiving money"
                                    Command="{Binding CancelAdjustAdvanceCommand}" VerticalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="{Binding AdvanceNotice, Mode=OneWay}" />
                                <Run Text="Choose the bills it pays. No new money is recorded." />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Bills to settle ===== -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"
                    Visibility="{Binding HasAccount, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="20,14,20,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Auto-fill oldest first (Alt+A)"
                                    Command="{Binding AutoFillCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Clear" Margin="8,0,0,0"
                                    Command="{Binding ClearAllocationsCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="Settle against bills" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                       Text="Type how much of each bill this money pays. Whatever is left stays as advance." />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Style="{StaticResource MutedText}" Margin="20,0,20,16"
                               Text="This customer has no unpaid bills. The whole amount will be kept as advance."
                               Visibility="{Binding HasNoOpenBills, Converter={StaticResource BoolToVisibility}}" />

                    <DataGrid ItemsSource="{Binding Bills}" IsReadOnly="False" BorderThickness="0,1,0,1"
                              AutomationProperties.Name="Unpaid bills" MaxHeight="420"
                              Visibility="{Binding HasOpenBills, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bill" Binding="{Binding Number}" Width="150" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="Due" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettleBillRow}">
                                        <TextBlock Text="{Binding DueText}" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bill amount" Binding="{Binding TotalText}" Width="130" IsReadOnly="True"
                                                ElementStyle="{StaticResource AmountCellText}" />
                            <DataGridTextColumn Header="Pending" Binding="{Binding PendingText}" Width="130" IsReadOnly="True"
                                                ElementStyle="{StaticResource AmountCellText}" />
                            <DataGridTemplateColumn Header="Settle now (₹)" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SettleBillRow}">
                                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                                 Margin="6,3" Padding="4,2" MinHeight="0"
                                                 AutomationProperties.Name="{Binding Number, StringFormat=Settle bill {0}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="20,12,20,14" HorizontalAlignment="Right">
                        <TextBlock Margin="0,0,24,0"><Run Text="Settled" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding SettledText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Margin="0,0,24,0"><Run Text="Kept as advance" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding AdvanceText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Text="{Binding BalanceAfterText}" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" />
                    </WrapPanel>
                    <TextBlock Margin="20,0,20,12" HorizontalAlignment="Right" Foreground="{StaticResource ErrorTextBrush}"
                               FontWeight="SemiBold" Text="The bills add up to more than the money available."
                               Visibility="{Binding IsOverAllocated, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ===== Messages and buttons ===== -->
            <Border Style="{StaticResource ErrorBox}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource SuccessBox}" Margin="0,16,0,0"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Print receipt"
                            Command="{Binding PrintLastReceiptCommand}" Margin="12,0,0,0"
                            Visibility="{Binding CanPrintLastReceipt, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource MutedText}" Text="Ctrl+S" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding SaveButtonText}" MinWidth="150"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
