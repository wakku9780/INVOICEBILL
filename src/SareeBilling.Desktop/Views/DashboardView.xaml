<UserControl x:Class="SareeBilling.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             xmlns:nav="clr-namespace:SareeBilling.Desktop.Navigation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,16">

            <!-- ===== Reminders ===== -->
            <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="900"
                    Visibility="{Binding IsCompanySetupNeeded, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Set up now"
                            Margin="16,0,0,0" VerticalAlignment="Center"
                            Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.CompanySettings}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="First step: enter your company details" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Your name, address and GSTIN are needed before you can create invoices." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16" HorizontalAlignment="Left" MaxWidth="900"
                    Visibility="{Binding IsBackupOverdue, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Back up now"
                            Margin="16,0,0,0" VerticalAlignment="Center"
                            Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.BackupRestore}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Time for a backup" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="{Binding BackupReminderText, Mode=OneWay}" />
                            <Run Text="Keep a copy on a pen drive in case this computer is lost or damaged." />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Period ===== -->
            <ItemsControl ItemsSource="{Binding Periods}" Focusable="False" AutomationProperties.Name="Period">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PeriodOption}">
                        <RadioButton Style="{StaticResource PeriodButton}" GroupName="DashboardPeriod"
                                     Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                     Command="{Binding DataContext.SelectPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding CustomFrom}" Width="140" SelectedDateFormat="Short"
                            AutomationProperties.Name="From date" />
                <TextBlock Text="To" VerticalAlignment="Center" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding CustomTo}" Width="140" SelectedDateFormat="Short"
                            AutomationProperties.Name="To date" />
                <Button Style="{StaticResource PrimaryButton}" Content="Show" Margin="12,0,0,0"
                        Command="{Binding ApplyCustomRangeCommand}" IsDefault="{Binding IsCustomPeriod}" />
            </StackPanel>

            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,8" HorizontalAlignment="Left"
                    Visibility="{Binding ErrorText, Converter={StaticResource VisibleWhenNotEmpty}}">
                <TextBlock Text="{Binding ErrorText}" />
            </Border>

            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12">
                <Run Text="Showing" /> <Run Text="{Binding PeriodText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <!-- ===== Summary figures (from saved invoices; cancelled ones excluded) ===== -->
            <UniformGrid Rows="1">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Sales (incl. GST)" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding SalesText}" />
                        <TextBlock Style="{StaticResource StatNote}" Text="{Binding SalesNote}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Taxable value" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TaxableText}" />
                        <TextBlock Style="{StaticResource StatNote}" Text="Before GST" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="GST collected" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding GstText}" />
                        <TextBlock Style="{StaticResource StatNote}" Text="{Binding GstNote}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Customers billed" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding CustomersText}" />
                        <TextBlock Style="{StaticResource StatNote}" Text="{Binding CustomersNote}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Quick actions ===== -->
            <TextBlock Style="{StaticResource SectionTitleText}" Text="Quick actions" Margin="0,12,0,12" />
            <UniformGrid Rows="1">
                <Button Style="{StaticResource QuickActionButton}" Background="{StaticResource AccentBrush}"
                        Foreground="White" BorderBrush="{StaticResource AccentBrush}"
                        Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.CreateInvoice}"
                        AutomationProperties.Name="Sales Invoice (F8)">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="F8" FontWeight="Normal" FontSize="12" Opacity="0.85"
                                   VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Width="26" VerticalAlignment="Center" />
                        <TextBlock Text="Sales Invoice" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}"
                        Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.InvoiceHistory}"
                        AutomationProperties.Name="Invoice History (Ctrl+H)">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+H" FontWeight="Normal" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" Width="26" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Invoice History" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}"
                        Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.Customers}">
                    <DockPanel>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE716;" Width="26" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Customers" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource QuickActionButton}"
                        Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.BackupRestore}">
                    <DockPanel>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" Width="26" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Back up data" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </UniformGrid>

            <!-- ===== Business overview ===== -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sales trend -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Sales trend" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="{Binding TrendCaption}"
                                   TextWrapping="Wrap" Margin="0,2,0,12" />
                        <ItemsControl ItemsSource="{Binding Trend}" Focusable="False" Height="196"
                                      AutomationProperties.Name="Sales by month">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrendBar}">
                                    <DockPanel Margin="4,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MonthLabel}" HorizontalAlignment="Center"
                                                   Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding AmountText}" FontSize="11" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Border Height="{Binding BarHeight}" MaxWidth="36" CornerRadius="3,3,0,0"
                                                    Background="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top customers -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Top customers" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="By sales in the period"
                                   Margin="0,2,0,12" />
                        <TextBlock Style="{StaticResource MutedText}" Text="No sales in this period."
                                   Visibility="{Binding HasNoTopCustomers, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding TopCustomers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TopCustomerRow}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Width="{Binding BarWidth}" Height="6" CornerRadius="3"
                                                        Background="{StaticResource AccentBrush}" Opacity="0.75"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InvoicesText}" FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SalesText}" Margin="12,0,0,0"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent invoices -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="View all invoices"
                                    Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.InvoiceHistory}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleText}" Text="Recent invoices" />
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                           Text="Newest in the period. Double-click or press Enter to open." />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" Text="No invoices in this period."
                                   Visibility="{Binding HasNoRecentInvoices, Converter={StaticResource BoolToVisibility}}" />
                        <DataGrid x:Name="RecentGrid" ItemsSource="{Binding RecentInvoices}"
                                  AutomationProperties.Name="Recent invoices"
                                  Visibility="{Binding HasRecentInvoices, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenInvoiceCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=RecentGrid}" />
                                <KeyBinding Key="Return" Command="{Binding OpenInvoiceCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=RecentGrid}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice no." Binding="{Binding InvoiceNumber}" Width="110"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="Customer" Binding="{Binding BuyerName}" Width="*"
                                                    ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:RecentInvoiceRow}">
                                            <TextBlock Margin="10,0" VerticalAlignment="Center" Text="Cancelled"
                                                       Foreground="{StaticResource ErrorTextBrush}" FontWeight="SemiBold"
                                                       Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Amount (₹)" Binding="{Binding AmountText}" Width="140"
                                                    ElementStyle="{StaticResource AmountCellText}">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap">
                <Run Text="All data is saved on this computer in" />
                <Run Text="{Binding DatabasePath, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
