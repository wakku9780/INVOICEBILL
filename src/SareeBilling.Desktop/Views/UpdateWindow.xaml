<Window x:Class="SareeBilling.Desktop.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UpdateDialogViewModel}"
        Title="Update available" Width="560" Height="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="A new version of Saree Billing is available" Style="{StaticResource SectionTitleText}" FontSize="18" />
            <TextBlock Text="{Binding PublishedText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TotalLabel}" Text="Your version" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersionText}" FontWeight="SemiBold" Margin="0,3" />
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TotalLabel}" Text="New version" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,3" />
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="What's new" />
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Text="{Binding SizeText}" />
            <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource SubtleBackgroundBrush}" AutomationProperties.Name="Release notes" />
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Text="Your invoices, customers and settings are kept. A backup is made automatically before updating. The app will close, update, and open again." />
            <ProgressBar Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StatusText, Converter={StaticResource VisibleWhenNotEmpty}}" />
            <Border Style="{StaticResource ErrorBox}" Margin="0,8,0,0"
                    Visibility="{Binding ErrorText, Converter={StaticResource VisibleWhenNotEmpty}}">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{Binding RemindLaterText}"
                    Command="{Binding RemindLaterCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Update now" Command="{Binding UpdateNowCommand}"
                    Margin="8,0,0,0" MinWidth="130" />
        </StackPanel>
    </Grid>
</Window>
