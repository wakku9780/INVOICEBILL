<UserControl x:Class="SareeBilling.Desktop.Views.CustomerLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CustomerLedgerViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Customer, period, filter, actions ===== -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Margin="0,0,16,8" Width="320">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Customer" />
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"
                          IsTextSearchEnabled="True" AutomationProperties.Name="Customer" />
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Style="{StaticResource FieldLabel}" Text="From" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="135" AutomationProperties.Name="From date" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
                <TextBlock Style="{StaticResource FieldLabel}" Text="To" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="135" AutomationProperties.Name="To date" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8" Width="170">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Show" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Entry type" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Button Style="{StaticResource SecondaryButton}" Content="Receive payment" Command="{Binding ReceivePaymentCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Export to Excel" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Print statement" Command="{Binding PrintCommand}" Margin="8,0,0,0"
                        ToolTip="Ctrl+P" />
            </StackPanel>
        </WrapPanel>

        <Border Grid.Row="1" Style="{StaticResource ErrorBox}" Margin="0,0,0,12" HorizontalAlignment="Left"
                Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" />
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Text="Choose a customer to see their ledger."
                   Visibility="{Binding HasNoCustomer, Converter={StaticResource BoolToVisibility}}" />

        <!-- ===== Summary ===== -->
        <StackPanel Grid.Row="2" Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding PartyText}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
            <UniformGrid Rows="1" Margin="0,0,0,4">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}">
                            <Run Text="Opening balance on" /> <Run Text="{Binding OpeningDateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding OpeningText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Total debit (billed)" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalDebitText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="Total credit (received / returned)" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalCreditText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Background="{StaticResource ReceivableBackgroundBrush}"
                        BorderBrush="{StaticResource ReceivableBorderBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{Binding ClosingLabel}" Foreground="{StaticResource ReceivableBrush}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding ClosingText}" Foreground="{StaticResource ReceivableBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ===== Entries ===== -->
        <DataGrid x:Name="LedgerGrid" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutomationProperties.Name="Ledger entries"
                  Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenEntryCommand}" />
                <KeyBinding Key="Return" Command="{Binding OpenEntryCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="105" ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="130" ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Ref. no." Binding="{Binding Reference}" Width="120" ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="*" ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Debit (₹)" Binding="{Binding DebitText}" Width="125" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="Credit (₹)" Binding="{Binding CreditText}" Width="125" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceText}" Width="145" ElementStyle="{StaticResource AmountCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasLedger, Converter={StaticResource BoolToVisibility}}"
                   Text="Dr = the customer owes you. Cr = advance held for the customer. Double-click an invoice, receipt or credit note to open it. Cancelled entries are not shown." />
    </Grid>
</UserControl>
