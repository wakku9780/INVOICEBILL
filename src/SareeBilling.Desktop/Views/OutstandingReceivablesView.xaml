<UserControl x:Class="SareeBilling.Desktop.Views.OutstandingReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OutstandingReceivablesViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Export to Excel" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Print" Command="{Binding PrintCommand}" Margin="8,0,0,0" ToolTip="Ctrl+P" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AsOfText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CustomersText}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Only customers with overdue bills" IsChecked="{Binding OverdueOnly}" Margin="20,0,0,0"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,4">
            <Border Style="{StaticResource StatCard}" Background="{StaticResource ReceivableBackgroundBrush}"
                    BorderBrush="{StaticResource ReceivableBorderBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Pending bills" Foreground="{StaticResource ReceivableBrush}" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalPendingText}" Foreground="{StaticResource ReceivableBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Overdue (past due date)" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalOverdueText}" Foreground="{StaticResource ErrorTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Advances held" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalAdvanceText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatLabel}" Text="Net balance" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalBalanceText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="Nothing is outstanding. Every bill is paid."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  RowDetailsVisibilityMode="VisibleWhenSelected" AutomationProperties.Name="Outstanding by customer">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenLedgerCommand}" />
                <KeyBinding Key="Return" Command="{Binding OpenLedgerCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Customer" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:OutstandingRowView}">
                            <TextBlock Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding CustomerName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding City, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Not due" Binding="{Binding NotDueText}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="1–30 days" Binding="{Binding Days1To30Text}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="31–60" Binding="{Binding Days31To60Text}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="61–90" Binding="{Binding Days61To90Text}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="Over 90" Binding="{Binding Over90Text}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceText}" Width="*" ElementStyle="{StaticResource AmountCellText}" />
                <DataGridTextColumn Header="Balance (₹)" Binding="{Binding BalanceText}" Width="1.3*" ElementStyle="{StaticResource AmountCellText}" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type vm:OutstandingRowView}">
                    <Border Background="{StaticResource SubtleBackgroundBrush}" Padding="40,6,16,10">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Bills}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OutstandingBillView}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateText}" />
                                            <TextBlock Grid.Column="2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding LateText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding PendingText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                       Text="Columns: bill · date · how late · bill amount · still pending" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Open ledger" Command="{Binding OpenLedgerCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Receive payment" Command="{Binding ReceivePaymentCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Ageing counts days after each bill's due date. Click a customer to see their unpaid bills." />
        </DockPanel>
    </Grid>
</UserControl>
