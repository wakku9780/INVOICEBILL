<UserControl x:Class="SareeBilling.Desktop.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupRestoreViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,16,0">

            <!-- ===== Messages ===== -->
            <Border Style="{StaticResource SuccessBox}" Margin="0,0,0,12"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource ErrorBox}" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- ===== Backup ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Make a backup" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14"
                               Text="A backup is one file containing your company details, customers and all invoices. Keep a copy outside this computer, for example on a pen drive, at least once a week." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Backup folder" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open folder"
                                Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Change folder…"
                                Command="{Binding ChangeFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 Background="{StaticResource SubtleBackgroundBrush}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Back up now" Command="{Binding BackupNowCommand}"
                                MinWidth="150" />
                        <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Restore ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Restore a backup" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                               Text="Restoring replaces ALL current data with the backup. Use it after a computer problem, or to move your data to a new computer. A safety copy of the current data is always saved first." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Backups in the folder above" />
                    <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="260"
                              MinHeight="110" AutomationProperties.Name="Backups">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Saved on" Binding="{Binding CreatedText}" Width="200"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"
                                                ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"
                                                ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource DangerButton}" Content="Restore selected backup…"
                                Command="{Binding RestoreSelectedCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Restore from another file…"
                                Command="{Binding RestoreFromFileCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Automatic backups ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleText}" Text="Automatic backups" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                               Text="The app also saves a copy automatically every day it is opened (the last 30 days are kept), and before every restore or update. These stay on this computer, so they do not replace a pen-drive backup." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open folder"
                                Command="{Binding OpenAutoBackupsCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AutoBackupFolder, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 Background="{StaticResource SubtleBackgroundBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
