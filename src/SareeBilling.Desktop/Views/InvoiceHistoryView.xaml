<UserControl x:Class="SareeBilling.Desktop.Views.InvoiceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceHistoryViewModel}">
    <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Filters ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,4" Width="300">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Search" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Invoice no., customer name or GSTIN" AutomationProperties.Name="Search invoices" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4" Width="170">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="From date" />
                    <DatePicker SelectedDate="{Binding FromDate}" Padding="6" />
                </StackPanel>
                <StackPanel Margin="0,0,16,4" Width="170">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="To date" />
                    <DatePicker SelectedDate="{Binding ToDate}" Padding="6" />
                </StackPanel>
                <StackPanel Margin="0,0,16,4" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="This month" Command="{Binding ThisMonthCommand}"
                            MinWidth="0" Padding="12,8" />
                    <Button Style="{StaticResource SecondaryButton}" Content="This year" Command="{Binding ThisYearCommand}"
                            MinWidth="0" Padding="12,8" Margin="6,0,0,0" ToolTip="Current financial year (from 1 April)" />
                    <Button Style="{StaticResource SecondaryButton}" Content="All dates" Command="{Binding AllDatesCommand}"
                            MinWidth="0" Padding="12,8" Margin="6,0,0,0" />
                </StackPanel>
                <CheckBox Content="Show cancelled" IsChecked="{Binding IncludeCancelled}" VerticalAlignment="Bottom"
                          Margin="0,0,0,12" />
            </WrapPanel>
        </Border>

        <!-- ===== Actions for the selected invoice ===== -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Cancel invoice…"
                    Command="{Binding CancelInvoiceCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Create credit note (return)"
                    Command="{Binding CreateCreditNoteCommand}" Margin="0,0,8,0" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Open / Preview" Command="{Binding PreviewCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Print…" Command="{Binding PrintCommand}"
                        Margin="8,0,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Save as PDF…" Command="{Binding SavePdfCommand}"
                        Margin="8,0,0,0" />
                <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="Select an invoice, or double-click it to open." />
            </StackPanel>
        </DockPanel>

        <!-- ===== Invoices ===== -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                  AutomationProperties.Name="Invoices">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PreviewCommand}" />
                <KeyBinding Key="Return" Command="{Binding PreviewCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice No." Binding="{Binding InvoiceNumber}" Width="170"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="110"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Customer" Binding="{Binding BuyerName}" Width="*" MinWidth="160"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Taxable value" Binding="{Binding TaxableText}" Width="130"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="GST" Binding="{Binding TaxText}" Width="110"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Grand total" Binding="{Binding GrandTotalText}" Width="130"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedText}" Width="110"
                                    ElementStyle="{StaticResource GridCellText}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="95"
                                    ElementStyle="{StaticResource GridCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" Style="{StaticResource HintText}" FontSize="13"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
