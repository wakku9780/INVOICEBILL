<UserControl x:Class="SareeBilling.Desktop.Views.CompanySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CompanySettingsViewModel}">
    <!-- Page width is capped so long lines stay readable on wide monitors. -->
    <Grid MaxWidth="1000" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel>

                <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16"
                        Visibility="{Binding IsFirstSetup, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Welcome! Please enter your business details. They are printed on every invoice. Fields marked * are required." />
                </Border>

                <!-- ===== Business details ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Business details" Margin="0,0,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Company name *" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. J A SAREES" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN *" />
                                <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" Tag="15-character GSTIN"
                                         CharacterCasing="Upper" MaxLength="15" FontFamily="Consolas" FontSize="15" />
                                <TextBlock Style="{StaticResource GstinHintText}" Text="{Binding GstinHint.Message}"
                                           Visibility="{Binding GstinHint.Message, Converter={StaticResource VisibleWhenNotEmpty}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="State *" />
                                <ComboBox ItemsSource="{Binding States}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code" SelectedValue="{Binding StateCode}" />
                                <TextBlock Style="{StaticResource HintText}" Text="Filled automatically from the GSTIN." />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Phone" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. 98765 43210" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Address line 1 *" />
                                <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Tag="Building, street, area" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Address line 2" />
                                <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Tag="Landmark, locality (optional)" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="City *" />
                                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pincode" />
                                <TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Email" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Invoice settings ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Invoice settings" Margin="0,0,0,14" />
                        <StackPanel Style="{StaticResource Field}" HorizontalAlignment="Left" Width="460">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Next invoice number *" />
                            <TextBox Text="{Binding NextInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"
                                     Width="160" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Invoices are numbered 1, 2, 3 … and the numbers never restart. Moving from Tally? Enter your last Tally invoice number + 1." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding InvoiceNumberExample}" Margin="0,-6,0,14"
                                   FontWeight="SemiBold" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Declaration (printed at the bottom of each invoice) *" />
                            <TextBox Style="{StaticResource MultiLineTextBox}"
                                     Text="{Binding DeclarationText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Bank details ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Bank details" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,14"
                                   Text="Optional. Printed on the invoice so customers know where to pay." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Bank name" />
                                <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Account number" />
                                <TextBox Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="IFSC code" />
                                <TextBox Text="{Binding BankIfsc, UpdateSourceTrigger=PropertyChanged}"
                                         CharacterCasing="Upper" MaxLength="11" Tag="e.g. SBIN0001234" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Branch" />
                                <TextBox Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Logo ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="Logo" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,14"
                                   Text="Optional. PNG or JPG image, smaller than 512 KB." />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="180" Height="90" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Background="{StaticResource SubtleBackgroundBrush}">
                                <Grid>
                                    <TextBlock Text="No logo" Foreground="{StaticResource PlaceholderBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="6"
                                           Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Choose image…"
                                        Command="{Binding ChooseLogoCommand}" Margin="0,0,0,8" />
                                <Button Style="{StaticResource DangerButton}" Content="Remove"
                                        Command="{Binding RemoveLogoCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== App updates ===== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="App updates" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" Text="{Binding AppVersionText}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Check for updates"
                                    Command="{Binding CheckForUpdatesCommand}" />
                            <TextBlock Text="{Binding UpdateStatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="560" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                                   Text="The app also checks automatically each time it starts. Without internet it simply skips the check." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Save bar (always visible) ===== -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource ErrorBox}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <Border Style="{StaticResource SuccessBox}"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource VisibleWhenNotEmpty}}">
                        <TextBlock Text="{Binding SuccessMessage}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save company details"
                        Command="{Binding SaveCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
