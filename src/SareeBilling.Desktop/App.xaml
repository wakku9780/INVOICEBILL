<Application x:Class="SareeBilling.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
             xmlns:views="clr-namespace:SareeBilling.Desktop.Views"
             xmlns:conv="clr-namespace:SareeBilling.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
    <!-- No StartupUri: the main window is created by dependency injection in App.xaml.cs. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:VisibleWhenNotEmptyConverter x:Key="VisibleWhenNotEmpty" />

            <!-- Each page view model is displayed with its matching view. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}">
                <views:CompanySettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateInvoiceViewModel}">
                <views:CreateInvoiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InvoiceHistoryViewModel}">
                <views:InvoiceHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <views:CustomersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
                <views:ComingSoonView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
