<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SareeBilling.Application\SareeBilling.Application.csproj" />
    <ProjectReference Include="..\SareeBilling.Infrastructure\SareeBilling.Infrastructure.csproj" />
    <ProjectReference Include="..\SareeBilling.Domain\SareeBilling.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- The program file is SareeBilling.exe; code namespaces stay SareeBilling.Desktop. -->
    <AssemblyName>SareeBilling</AssemblyName>
    <RootNamespace>SareeBilling.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Title>Saree Billing</Title>
    <Description>GST billing and invoicing for a saree wholesale business.</Description>

    <!-- Only English resource files; keeps the installer small. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
