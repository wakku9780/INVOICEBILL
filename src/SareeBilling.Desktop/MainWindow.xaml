<Window x:Class="SareeBilling.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SareeBilling.Desktop.ViewModels"
        xmlns:nav="clr-namespace:SareeBilling.Desktop.Navigation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Saree Billing - GST Invoicing"
        Icon="/Assets/app.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <!-- Shortcuts work from every page, like Tally (F8 = sales). -->
    <Window.InputBindings>
        <KeyBinding Key="F8" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.CreateInvoice}" />
        <KeyBinding Key="F8" Modifiers="Control" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.CreditNote}" />
        <KeyBinding Key="F6" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.ReceivePayment}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.Dashboard}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static nav:AppPage.InvoiceHistory}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,18,20,14">
                <TextBlock Text="Saree Billing" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="GST Invoicing" Foreground="{StaticResource SidebarMutedTextBrush}" FontSize="13" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding NavigationGroups}" Focusable="False"
                              KeyboardNavigation.TabNavigation="Continue"
                              AutomationProperties.Name="Main menu">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationGroup}">
                            <StackPanel Margin="0,0,0,4">
                                <ToggleButton Style="{StaticResource SidebarGroupHeader}"
                                              Content="{Binding Title}"
                                              IsChecked="{Binding IsExpanded}"
                                              Visibility="{Binding HasHeader, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                            <Button Style="{StaticResource SidebarNavButton}"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding AutomationName}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" FontSize="11"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Foreground="{StaticResource SidebarMutedTextBrush}" />
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}"
                                                               FontSize="15" Width="28" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Margin="20,12,20,16" FontSize="12"
                       Foreground="{StaticResource SidebarMutedTextBrush}" Text="{Binding AppVersion}" />
        </Grid>

        <!-- ===== Page area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Update banner: informs without interrupting; details open only when clicked. -->
            <Border Grid.Row="0" Background="{StaticResource InfoBackgroundBrush}" BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,8"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Later"
                            Command="{Binding RemindUpdateLaterCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="See what's new"
                            Command="{Binding ShowUpdateCommand}" MinHeight="30" Padding="14,4" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="16" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="28,18">
                <TextBlock Style="{StaticResource PageTitleText}" Text="{Binding CurrentPage.Title}" />
            </Border>

            <ContentControl Grid.Row="2" Margin="28,24,12,12" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
