<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for the installer: 64-bit Windows, self-contained (the .NET 8 runtime is
  included, so nothing else needs to be installed on the target computer).
  Used by build-installer.ps1:  dotnet publish src\SareeBilling.Desktop -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Pre-compiles code for faster start-up on the shop computer. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
